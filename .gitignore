# Ignore untracked images and media by extension. This does not untrack files
# that Git already tracks.
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.ico
*.svg
*.mp4
*.mov
*.avi
*.webm
*.pdf
*.zip
*.rar
*.7z
*.tar.gz

# Git ignore patterns cannot filter files by size; ignore these extensions
# explicitly instead.
*.gz
*.tar

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Environments
.env
.venv
env/
venv/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
ehthumbs.db
*.tmp